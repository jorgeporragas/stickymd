{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sticky.md",
  "mainBinaryName": "stickymd",
  "version": "1.0.2",
  "identifier": "com.stickymd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "note",
        "url": "src/windows/note/index.html",
        "title": "sticky.md",
        "width": 320,
        "height": 320,
        "minWidth": 240,
        "minHeight": 200,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "hub",
        "create": false,
        "url": "src/windows/hub/index.html",
        "title": "sticky.md — notes",
        "width": 360,
        "height": 520,
        "minWidth": 280,
        "minHeight": 320,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "settings",
        "create": false,
        "url": "src/windows/settings/index.html",
        "title": "sticky.md — settings",
        "width": 380,
        "height": 460,
        "minWidth": 320,
        "minHeight": 360,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/jorgeporragas/stickymd/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxQkZGMjUwRTFCQTk4Q0IKUldUTG1McmhVUEsva1lNRit0R2QxUENEQXJBZUorUlFIb1ZxYWs4VDZhdHRTREIxZytzRE1pbysK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "A markdown scratchpad.",
    "longDescription": "A markdown scratchpad. Notes render as you type, stay plain .md files on disk, and never leave your machine.",
    "copyright": "Copyright (C) 2026 Jorge. Licensed under GPL-3.0-only.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
