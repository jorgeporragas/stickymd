{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StickyMD",
  "version": "0.1.0",
  "identifier": "com.stickymd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "note",
        "url": "src/windows/note/index.html",
        "title": "StickyMD",
        "width": 320,
        "height": 320,
        "minWidth": 240,
        "minHeight": 200,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'"
    }
  }
}
